@startuml
' Cấu hình hiển thị
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide circle
title CLINIC MANAGEMENT SYSTEM

' Cấu hình cho STUB CLASS
skinparam class {
    BackgroundColor<<Stub>> #F0F0F0
    BorderColor<<Stub>> #Gray
    BorderStyle<<Stub>> dashed
    FontColor<<Stub>> #555555
}

scale 2

class "Roles" {
    + id : Long
    + code : String
    + name : String
    + description : String
}

' code: MANAGER, DOCTOR, RECEPTIONIST

class "Users" {
    + id : Long
    + roleId : Long
    + username : String
    + passwordHash : String
    + fullName : String
    + phone : String
    + status : String
    + createdAt : DateTime
    + updatedAt : DateTime
}

class Departments {
    + id: Long
    + code: String
    + name: String
    + description: String
}

class DoctorDepartment {
    + departmentId: Long
    + doctorId: Long
}

class Rooms {
    + id : Long
    + roomNumber : String
}

class Patients {
    + id : Long
    + patientCode : String
    + fullName : String
    + dob : Date
    + gender : String
    + phone : String
    + address : String
    + email: String
    + cccd : String
    + bhytNumber : String          
    + createdAt : DateTime
    + updatedAt : DateTime
}

class DoctorSlot {
    + id : Long
    + roomId : Long
    + doctorId : Long
    + slotDate : Date
    + startTime : Time           
    + endTime : Time
    + capacity : Int              
    + status : String             
}


'capacity: lưu số lượng bệnh nhân tối đa cho một slot'
'Mặc định trước mắt là 5 bệnh nhân cho một slot'

class Appointments {
    + id : Long
    + slotId : Long               
    + patientId : Long
    + doctorId : Long
    + appointmentCode : String
    + departmentId: Long
    + sequenceNumber : Int       
    + bookingType : String        
    + patientType : String       
    + bhytNumber : String        
    + reason : String
    + status : String     
    + creatorId : Long
    + createdAt : DateTime
    + updatedAt : DateTime
}
'slotId: liên kết DoctorSlot'
'Apointments status: CONFIRMED, WAITING, IN_PROGRESS, COMPLETED, CANCELLED'
'bookingType status: SCHEDULE, WALK_IN'
'patientType status: BHYT, SERVICE'
'Một bác sĩ cho phép khám nhiều bệnh nhân cùng lúc.
' Cho phép lưu nháp hồ sơ hiện tại và giữ trạng thái IN_PROGRESS, sau đó bệnh nhân làm xét nghiệm các thứ xong thì quay lại khám tiếp
' Đặt lịch xong đưa số luôn, không quan trọng là bệnh nhân có đến khám hay không -> từ bỏ tính tuyệt đối của số  khám bệnh 

' Chuyển trạng thái:
' Đặt qua điện thoại: Lễ tân bấm "Tạo lịch" -> confirmed, tạo số, tạo mã cuộc hẹn -> Khách đến -> bấm "Vào khám" -> chuyển sang waiting -> bác sĩ bấm "Bắt đầu khám" -> In_Progress
' Khách vãng lai: Bước vào phòng khám -> Bắt số  -> lễ tân bấm "Khám ngay" -> tạo số, tạo mã cuộc hẹn -> Trạng thái waiting
' IN_PROGRESS -> CANCELLED
    'Bác sĩ cancel
    'Trường hợp bác sĩ không thể khám tiếp được: Có ca cấp cứu, hoặc có chuyện đột xuất -> bác sĩ cancelled khám, điền lý do cancelled
    'Trường hợp bệnh nhân bỏ về: Bác sĩ cancelled -> điền lý do cancelled
' WAITING -> CAnCELLED
    ' Lễ tân cancel
    ' Khách đang đợi đột nhiên đi về -> lễ tân có thể cancel ngay tại giao diện
    ' Khi cuộc hẹn chuyển sang đang khám, lễ tân hết trách nhiệm
' CONFIRMTED -> CANCELLED
    ' Lễ tân cacel thủ công
    ' hệ thống cancel tự động
        ' Giả sử khách đặt vé trong khoảng từ 6:00 - 16:00 nhưng bệnh nhân không có mặt đúng giờ, hệ thống tự động hủy vé đó
        ' Đảm bảo bệnh nhân đặt lịch trong khoảng 16:00 - 17:00 có thể khám và bác sĩ có thể về lúc 17:00


together {
    class "MedicalRecords" {
        + id : Long
        + appointmentId : Long
        + symptoms : String
        + diagnosis : String
        + notes : String
        + createdAt : DateTime
        + updatedAt : DateTime
    }
}

' === STUB CLASS (Đại diện cho dịch vụ ngoài trong Microservices) ===
class "Auth_Service" <<Stub>> {
    + token : String
    + payload : String
    + verifyToken() : Boolean
}


' === QUAN HỆ ===

' Quan hệ phân quyền
Roles "1" -up- "0..*" Users

' Quan hệ nghiệp vụ phòng khám (Core)
Patients "1" -- "0..*" Appointments
Users "1" -- "0..*" Appointments

' Quan hệ 1-1 giữa Lịch khám và Bệnh án thực tế
Appointments "1" *-- "0..1" MedicalRecords

' Quan hệ với dịch vụ bên ngoài (Microservices)
Auth_Service "1" .. "0..*" Users

DoctorSlot "1" -- "0..*" Appointments

Departments "1" -- "0..*" Users
Departments "1" -- "0..*" Appointments

DoctorDepartment "1" -- "0..*" Users
DoctorDepartment "1" -- "0..*" Departments


Rooms "1" -- "0..*" DoctorSlot

