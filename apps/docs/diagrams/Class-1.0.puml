@startuml
title CLINIC MANAGEMENT SYSTEM — MVP 1.0\nDjango Data Model

left to right direction

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam noteBackgroundColor #FFF8DC
skinparam noteBorderColor #888888
hide circle
hide methods

' =========================================================
' ENUMS
' =========================================================

package "Enumerations" {

    enum AppointmentStatus {
        CONFIRMED
        WAITING
        IN_PROGRESS
        COMPLETED
        CANCELLED
    }

    enum AppointmentType {
        SCHEDULED
        WALK_IN
    }

    enum MedicalOrderType {
        LAB_TEST
        IMAGING
        PROCEDURE
        OTHER
    }
}

' =========================================================
' CORE / IDENTITY
' =========================================================

package "Identity and Patient" {

    class User <<AUTH_USER_MODEL>> {
        +id : BigInt <<PK>>
        --
        +username : String
        +full_name : String
        +email : String
        +phone : String
        +role : String
        +is_active : Boolean
        +date_joined : DateTime
    }

    note right of User
      User là settings.AUTH_USER_MODEL.

      Các trường ngoài id chỉ mang tính minh họa.
      Cấu trúc thực tế phụ thuộc custom User model.

      Một User có thể đóng nhiều vai trò:
      - Doctor
      - Appointment creator
      - Check-in operator
      - Consultation starter
      - Completion operator
      - Cancellation operator
      - Medical record finalizer
      - Status changer
    end note

    class Patient {
        +id : BigInt <<PK>>
        --
        +patient_code : String
        +full_name : String
        +date_of_birth : Date
        +gender : String
        +phone : String
        +address : Text
        +is_active : Boolean
        +created_at : DateTime
        +updated_at : DateTime
    }

    note bottom of Patient
      Các trường Patient được trình bày theo
      sơ đồ tham khảo trong đặc tả.

      Dữ liệu bệnh nhân đã được tham chiếu
      không được xóa vật lý.
      Nên vô hiệu hóa bằng is_active.
    end note
}

' =========================================================
' APPOINTMENT
' =========================================================

package "Appointment Management" {

    class Appointment {
        +id : BigInt <<PK>>
        --
        +patient_id : BigInt <<FK, NOT NULL>>
        +doctor_id : BigInt <<FK, NOT NULL>>
        +creator_id : BigInt <<FK, NOT NULL>>
        --
        +appointment_type : AppointmentType
        +start_time : DateTime
        +end_time : DateTime
        +reason : Text
        +note : Text
        +status : AppointmentStatus
        --
        +checked_in_at : DateTime?
        +checked_in_by_id : BigInt? <<FK>>
        --
        +consultation_started_at : DateTime?
        +consultation_started_by_id : BigInt? <<FK>>
        --
        +completed_at : DateTime?
        +completed_by_id : BigInt? <<FK>>
        --
        +cancelled_at : DateTime?
        +cancelled_by_id : BigInt? <<FK>>
        +cancellation_reason : Text
        --
        +created_at : DateTime
        +updated_at : DateTime
    }

    class AppointmentStatusHistory {
        +id : BigInt <<PK>>
        --
        +appointment_id : BigInt <<FK, NOT NULL>>
        +from_status : AppointmentStatus?
        +to_status : AppointmentStatus
        +changed_by_id : BigInt <<FK, NOT NULL>>
        +reason : Text
        +changed_at : DateTime
    }

    note right of Appointment
      DATABASE CONSTRAINTS

      CK appointment_end_after_start:
      end_time > start_time

      UQ unique_in_progress_appointment_per_doctor:
      Mỗi doctor chỉ có tối đa một Appointment
      có status = IN_PROGRESS.

      OVERLAP RULE

      existing.start_time < new.end_time
      AND
      existing.end_time > new.start_time

      Chỉ kiểm tra cùng doctor và status:
      CONFIRMED, WAITING,
      IN_PROGRESS, COMPLETED.

      CANCELLED không chiếm lịch.

      Overlap phải được kiểm tra trong
      transaction.atomic().
    end note

    note bottom of Appointment
      INITIAL STATE

      SCHEDULED -> CONFIRMED
      WALK_IN   -> WAITING

      WALK_IN:
      start_time = checked_in_at
      end_time = start_time + 30 phút

      Thời gian dự kiến:
      start_time, end_time

      Thời gian vận hành:
      checked_in_at
      consultation_started_at
      completed_at

      Thời gian vận hành không được tự động
      làm thay đổi thời gian dự kiến.
    end note

    note right of AppointmentStatusHistory
      Mỗi lần chuyển trạng thái thành công
      phải tạo chính xác một bản ghi lịch sử.

      from_status có thể rỗng cho bản ghi
      trạng thái khởi tạo.

      Khi to_status = CANCELLED:
      reason là bắt buộc.
    end note
}

' =========================================================
' CLINICAL
' =========================================================

package "Clinical Documentation" {

    class MedicalRecord {
        +id : BigInt <<PK>>
        --
        +appointment_id : BigInt <<FK, UNIQUE, NOT NULL>>
        +patient_id : BigInt <<FK, NOT NULL>>
        +doctor_id : BigInt <<FK, NOT NULL>>
        --
        +symptoms : Text
        +diagnosis : Text
        +icd_code : String
        +treatment_plan : Text
        +notes : Text
        --
        +pulse : PositiveSmallInteger?
        +systolic_blood_pressure : PositiveSmallInteger?
        +diastolic_blood_pressure : PositiveSmallInteger?
        +temperature : Decimal(4,1)?
        +spo2 : PositiveSmallInteger?
        +weight_kg : Decimal(5,2)?
        +height_cm : Decimal(5,1)?
        --
        +is_finalized : Boolean
        +finalized_at : DateTime?
        +finalized_by_id : BigInt? <<FK>>
        --
        +created_at : DateTime
        +updated_at : DateTime
    }

    class PrescriptionItem {
        +id : BigInt <<PK>>
        --
        +medical_record_id : BigInt <<FK, NOT NULL>>
        +medication_name : String(255)
        +dosage : String(100)
        +quantity : PositiveInteger
        +unit : String(50)
        +instructions : Text
        +sort_order : PositiveInteger
        +created_at : DateTime
        +updated_at : DateTime
    }

    class MedicalOrder {
        +id : BigInt <<PK>>
        --
        +medical_record_id : BigInt <<FK, NOT NULL>>
        +order_type : MedicalOrderType
        +name : String(255)
        +purpose : Text
        +instructions : Text
        +created_at : DateTime
        +updated_at : DateTime
    }

    note right of MedicalRecord
      CONSISTENCY RULES

      patient_id =
        appointment.patient_id

      doctor_id =
        appointment.doctor_id

      FINALIZATION RULES

      Khi is_finalized = true:
      - symptoms bắt buộc
      - diagnosis bắt buộc
      - finalized_at bắt buộc
      - finalized_by bắt buộc

      appointment là OneToOne:
      Một cuộc hẹn có tối đa một hồ sơ khám.
    end note

    note bottom of PrescriptionItem
      MVP không có bảng Prescription riêng.

      Thuốc được nhập tự do bằng
      medication_name.

      Không liên kết medication catalog
      hoặc inventory.
    end note

    note bottom of MedicalOrder
      MedicalOrder chỉ biểu diễn yêu cầu
      chuyên môn.

      MVP chưa quản lý:
      - Trạng thái thực hiện
      - Kết quả
      - Thanh toán
      - Tích hợp phòng xét nghiệm
      - Tích hợp chẩn đoán hình ảnh
    end note
}

' =========================================================
' RELATIONSHIPS: PATIENT
' =========================================================

Patient "1" <-- "0..*" Appointment
Patient "1" <-- "0..*" MedicalRecord

' =========================================================
' RELATIONSHIPS: APPOINTMENT USER REFERENCES
' =========================================================

User "1" <-- "0..*" Appointment : doctor\nPROTECT
User "1" <-- "0..*" Appointment : creator\nPROTECT
User "0..1" <-- "0..*" Appointment : checked_in_by\nPROTECT
User "0..1" <-- "0..*" Appointment : consultation_started_by\nPROTECT
User "0..1" <-- "0..*" Appointment : completed_by\nPROTECT
User "0..1" <-- "0..*" Appointment : cancelled_by\nPROTECT

' =========================================================
' RELATIONSHIPS: APPOINTMENT HISTORY
' =========================================================

Appointment "1" <-- "0..*" AppointmentStatusHistory : CASCADE
User "1" <-- "0..*" AppointmentStatusHistory : changed_by\nPROTECT

' =========================================================
' RELATIONSHIPS: MEDICAL RECORD
' =========================================================

Appointment "1" <-- "0..1" MedicalRecord : PROTECT
User "1" <-- "0..*" MedicalRecord : doctor\nPROTECT
User "0..1" <-- "0..*" MedicalRecord : finalized_by\nPROTECT

MedicalRecord "1" *-- "0..*" PrescriptionItem : CASCADE
MedicalRecord "1" *-- "0..*" MedicalOrder : CASCADE

' =========================================================
' ENUM DEPENDENCIES
' =========================================================

Appointment ..> AppointmentStatus
Appointment ..> AppointmentType
AppointmentStatusHistory ..> AppointmentStatus
MedicalOrder ..> MedicalOrderType

' =========================================================
' INDEXES
' =========================================================

note "Appointment indexes\n\n1. (doctor_id, start_time)\n   appt_doctor_start_idx\n\n2. (doctor_id, status, checked_in_at)\n   appt_doctor_queue_idx\n\n3. (patient_id, created_at DESC)\n   appt_patient_history_idx\n\n4. (status, start_time)\n   appt_status_start_idx\n\n5. status có db_index=True" as AppointmentIndexes
AppointmentIndexes .. Appointment

note "AppointmentStatusHistory index\n\n(appointment_id, changed_at)\nappt_history_time_idx" as HistoryIndexes
HistoryIndexes .. AppointmentStatusHistory

note "MedicalRecord indexes\n\n1. (patient_id, created_at DESC)\n   medical_patient_history_idx\n\n2. (doctor_id, created_at DESC)\n   medical_doctor_history_idx\n\n3. is_finalized có db_index=True" as MedicalIndexes
MedicalIndexes .. MedicalRecord

@enduml