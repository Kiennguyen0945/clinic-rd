# ============================
# Python Production Build
# ============================
FROM python:3.14.5-alpine3.23

WORKDIR /apps/backend

# Install system dependencies for psycopg2 and cron
RUN apk add --no-cache gcc musl-dev libffi-dev postgresql-dev dcron

# Install Python dependencies
COPY apps/backend/requirements.txt .
RUN python3 -m venv /opt/venv && \
/opt/venv/bin/pip install --upgrade pip && \
/opt/venv/bin/pip install -r requirements.txt && \
/opt/venv/bin/pip install gunicorn

# Copy application code
COPY apps/backend/ .

# Collect static files
RUN mkdir -p /apps/backend/productionfiles && \
    /opt/venv/bin/python manage.py collectstatic --no-input --clear || true

# Copy production entrypoint
COPY apps/docker/backend/entrypoint.prod.sh /entrypoint.sh
COPY cron/backend /etc/crontabs/root
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
