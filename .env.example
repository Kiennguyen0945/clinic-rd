# Clinic Core
DJANGO_DB_ENGINE=postgres
DJANGO_SECRET_KEY=replace-with-a-random-development-secret
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Clinic Core PostgreSQL
POSTGRES_DB=clinic_core_db
POSTGRES_USER=clinic_core_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=clinic-core-db
POSTGRES_PORT=5432

# Reporting Service (separate database credentials)
REPORTING_DJANGO_SECRET_KEY=replace-with-a-different-random-secret
REPORTING_DB_NAME=reporting_db
REPORTING_DB_USER=reporting_user
REPORTING_DB_PASSWORD=replace-with-a-different-strong-password
REPORTING_DB_HOST=reporting-db
REPORTING_DB_PORT=5432

# Reserved for Reporting -> Clinic Core HTTP communication in the next phase
CLINIC_CORE_URL=http://clinic-core:8000
INTERNAL_SERVICE_TOKEN=replace-with-a-random-service-token

# Optional pgAdmin profile
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-password
